{
	"info": {
		"_postman_id": "8f5a4329-c128-48be-8a71-a83d47bf1b09",
		"name": "HelpDesk Ticket Escalation API",
		"description": "Comprehensive Postman collection for the HelpDesk SaaS Ticket Escalation & Multi-Channel Notification Engine.\n\n- Unified API responses powered by yousef-ahmed-abdalgawad/laravel-api-responder (built by myself)\n- Interactive documentation generated with Knuckles Scribe (/docs)\n- Supports both frictionless evaluation and authenticated user attribution (Sanctum)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "ticketId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "bearerToken",
			"value": "YOUR_SANCTUM_TOKEN",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Documentation (Scribe)",
			"item": [
				{
					"name": "1. Interactive HTML Docs (Scribe)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/docs",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"docs"
							]
						},
						"description": "Opens the interactive Knuckles Scribe documentation generated from route code, form requests, and response transformers."
					},
					"response": []
				},
				{
					"name": "2. OpenAPI 3.0 Specification",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/docs.openapi",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"docs.openapi"
							]
						},
						"description": "Retrieves the OpenAPI specification generated by Scribe."
					},
					"response": []
				}
			]
		},
		{
			"name": "Tickets",
			"item": [
				{
					"name": "3. List Tickets (Paginated)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/tickets",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tickets"
							]
						},
						"description": "Retrieves paginated tickets with their customer and agent associations."
					},
					"response": []
				},
				{
					"name": "4. Get Single Ticket Details",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tickets",
								"{{ticketId}}"
							]
						},
						"description": "Retrieves comprehensive ticket details including customer, agent, escalation records, and notification delivery logs."
					},
					"response": []
				}
			]
		},
		{
			"name": "Escalation",
			"item": [
				{
					"name": "5. Escalate Ticket (Frictionless / Body Attribution)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reason\": \"Production payment failure SLA breached. Critical customer impact.\",\n    \"escalated_by\": 1\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tickets/{{ticketId}}/escalate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tickets",
								"{{ticketId}}",
								"escalate"
							]
						},
						"description": "Escalates an open ticket without requiring auth tokens for seamless review testing. Attribution can be supplied in the body."
					},
					"response": []
				},
				{
					"name": "6. Escalate Ticket (Sanctum Authenticated)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{bearerToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reason\": \"Escalated by logged in supervisor.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tickets/{{ticketId}}/escalate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tickets",
								"{{ticketId}}",
								"escalate"
							]
						},
						"description": "Demonstrates auth-aware escalation. If a Sanctum token is passed, the controller automatically binds the authenticated user ID as the escalator."
					},
					"response": []
				},
				{
					"name": "7. Escalate Ticket - Validation / Domain Failure (422)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reason\": \"Attempting to re-escalate an already closed or resolved ticket\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tickets/{{ticketId}}/escalate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tickets",
								"{{ticketId}}",
								"escalate"
							]
						},
						"description": "Demonstrates domain validation when attempting to escalate a ticket that is already escalated, closed, or resolved."
					},
					"response": []
				},
				{
					"name": "8. Escalate Non-Existent Ticket (404)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reason\": \"Ticket does not exist\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/tickets/999999/escalate",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"tickets",
								"999999",
								"escalate"
							]
						},
						"description": "Returns a standardized 404 unified error response via ApiResponser."
					},
					"response": []
				}
			]
		},
		{
			"name": "Frontend Web Pages",
			"item": [
				{
					"name": "9. Tickets Web Dashboard",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/tickets",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"tickets"
							]
						},
						"description": "Renders Inertia.js React frontend listing all tickets."
					},
					"response": []
				},
				{
					"name": "10. Ticket Detail & Escalation Page",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/tickets/{{ticketId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"tickets",
								"{{ticketId}}"
							]
						},
						"description": "Renders Inertia.js React page with ticket details and interactive 'Escalate Ticket' button."
					},
					"response": []
				}
			]
		}
	]
}
